    "calendar.duty.excel.failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Failed to upload the duty file." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "근무표 업로드에 실패했습니다." } } } },

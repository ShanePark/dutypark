    "calendar.discard.action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discard" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경사항 버리기" } } } },
    "calendar.aiConsent.prompt.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognize a time with AI?" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "AI로 일정 시간을 인식할까요?" } } } },
    "calendar.aiConsent.prompt.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To extract a time, the schedule date and text content are sent to an external AI processing service. Member and team identifiers are not sent. This is optional, can be withdrawn in Settings, and manual time entry is always available. If the consent request fails, the schedule is still saved without AI." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "시간 추출을 위해 일정 날짜와 내용 텍스트를 외부 AI 처리 서비스로 전송합니다. 회원·팀 식별자는 전송하지 않습니다. 선택 사항이며 설정에서 철회할 수 있고, 수동 시간 입력도 항상 가능합니다. 동의 처리에 실패해도 일정은 AI 없이 저장됩니다." } } } },
    "calendar.aiConsent.prompt.agree" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Agree and recognize" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "동의하고 자동 인식" } } } },
    "calendar.aiConsent.prompt.decline" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save without AI" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "동의하지 않고 그대로 저장" } } } }

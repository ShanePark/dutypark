    "calendar.compare.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose up to %lld friends to show on your calendar." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 달력에 함께 표시할 친구를 최대 %lld명 선택하세요." } } } },

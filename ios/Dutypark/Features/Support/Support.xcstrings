    "support.guest.entry" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact support"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문의하기"
          }
        }
      }
    },
    "support.guide.block.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block from the ⋯ menu on a friend card, or from the ⋯ menu on the member's calendar. Blocking removes the friendship and hides both calendars, search results, requests and notifications from each other. Duty rosters of the same team stay visible."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구 카드의 ⋯ 메뉴 또는 상대방 달력의 ⋯ 메뉴에서 차단할 수 있습니다. 차단하면 친구 관계가 해제되고 서로의 달력·검색·요청·알림이 차단됩니다. 같은 팀 근무표는 계속 표시됩니다."
          }
        }
      }
    },
    "support.guide.block.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking a user"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 차단"
          }
        }
      }
    },
    "support.guide.policy.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every report is reviewed within 24 hours of submission, and we remove the content or suspend the account when needed. To appeal an account suspension, use the inquiry form below."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접수된 신고는 24시간 이내에 확인해 콘텐츠 삭제나 계정 이용 정지 등 필요한 조치를 합니다. 계정 이용 정지에 대한 이의제기도 아래 문의 양식으로 접수해 주세요."
          }
        }
      }
    },
    "support.guide.policy.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How we handle reports"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 기준"
          }
        }
      }
    },
    "support.guide.report.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the member's calendar and choose \"Report user\" from the ⋯ menu at the top right, or use the report action on a schedule row or a to-do."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대방 달력 우측 상단 ⋯ 메뉴에서 '사용자 신고'를 선택하거나, 일정과 할일의 신고 버튼으로 접수할 수 있습니다."
          }
        }
      }
    },
    "support.guide.report.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporting a user or content"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자·콘텐츠 신고"
          }
        }
      }
    },
    "support.intro.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check how reporting and blocking work, then send us a message with the form below."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신고와 차단 방법, 처리 기준을 확인한 뒤 아래 양식으로 문의를 남겨 주세요."
          }
        }
      }
    },
    "support.intro.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need help or want to report something?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도움이 필요하거나 신고할 내용이 있나요?"
          }
        }
      }
    },
    "support.success.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will reply to the e-mail address you provided. Reports are reviewed within 24 hours."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력하신 이메일 주소로 답변드리겠습니다. 신고 건은 접수 후 24시간 이내에 확인합니다."
          }
        }
      }
    },
    "support.success.newInquiry" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

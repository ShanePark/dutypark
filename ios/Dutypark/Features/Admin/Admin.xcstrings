{
  "sourceLanguage": "en",
  "strings": {
    "admin.access.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This area is available only to service administrators."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta área solo está disponible para administradores del servicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この領域はサービス管理者のみ利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 관리자만 이용할 수 있는 메뉴입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此区域仅供服务管理员使用。"
          }
        }
      }
    },
    "admin.access.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator access required"

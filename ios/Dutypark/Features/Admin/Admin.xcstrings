        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理员权限"
          }

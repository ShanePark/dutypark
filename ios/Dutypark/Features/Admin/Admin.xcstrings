    "admin.teams.delete.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@? Teams with members cannot be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Los equipos con miembros no se pueden eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？メンバーがいるチームは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 팀을 삭제할까요? 회원이 있는 팀은 삭제할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@？有成员的团队无法删除。"
          }
        }
      }
    },

    "todo.help.open" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Help" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "도움말" } } } },
    "todo.help.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Using the Todo board" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "할일 보드 사용법" } } } },
    "todo.help.kanban.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What is a Kanban board?" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "칸반 보드란?" } } } },
    "todo.help.kanban.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage work in To do, In progress, and Done. Drag cards to change their status." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "할 일을 할 일, 진행 중, 완료 세 단계로 관리하며 카드를 드래그해 상태를 바꿀 수 있습니다." } } } },
    "todo.help.todo.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To do" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "할 일" } } } },
    "todo.help.todo.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tasks you have not started appear here. Use + to add one." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 시작하지 않은 할 일이 표시됩니다. + 버튼으로 새 할 일을 추가하세요." } } } },
    "todo.help.progress.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In progress" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "진행 중" } } } },
    "todo.help.progress.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current work appears here and is also shown on your calendar." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 작업 중인 할 일이며 내 달력에도 표시됩니다." } } } },
    "todo.help.done.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } } } },
    "todo.help.done.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Completed tasks stay here and can be reopened at any time." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료한 할 일이 보관되며 필요하면 언제든 다시 열 수 있습니다." } } } },
    "todo.help.tips.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tips" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 팁" } } } },
    "todo.help.tip.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag a card to change its status." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "카드를 드래그해 상태를 변경하세요." } } } },
    "todo.help.tip.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag within a column to reorder tasks." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 열 안에서도 드래그해 순서를 바꿀 수 있습니다." } } } },
    "todo.help.tip.3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap a card to view and edit details." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "카드를 눌러 상세 내용을 확인하고 수정하세요." } } } },
    "todo.help.tip.4" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set a due date to stay on schedule." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마감일을 설정해 기한을 관리하세요." } } } },
    "todo.help.tip.5" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Attach photos or files when needed." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "필요할 때 사진이나 파일을 첨부할 수 있습니다." } } } },
    "todo.label.attachments" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Attachments" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "첨부파일" } } } },
    "todo.label.shared" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shared Todo" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "공유된 Todo" } } } },
    "todo.loading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading Todos" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Todo를 불러오는 중" } } } },
    "todo.status.done" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } } } },
    "todo.status.inProgress" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In progress" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "진행 중" } } } },
    "todo.status.todo" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To do" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "할 일" } } } },
    "todo.status.unknown" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알 수 없음" } } } },
    "todo.statusShort.done" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } } } },
    "todo.statusShort.inProgress" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Doing" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "진행중" } } } },
    "todo.statusShort.todo" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Todo" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "할 일" } } } }

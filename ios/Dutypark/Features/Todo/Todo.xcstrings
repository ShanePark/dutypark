    "todo.drag.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Touch and hold, then drag to reorder or change status." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantén pulsado y arrastra para reordenar o cambiar el estado." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "長押ししてドラッグすると、並べ替えやステータス変更ができます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "길게 누른 뒤 드래그하여 순서나 상태를 변경할 수 있습니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长按并拖动以重新排序或更改状态。" } } } },

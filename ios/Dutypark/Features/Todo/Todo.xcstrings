    "todo.confirm.deleteMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Todo and its attachments will be deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se eliminarán esta tarea y sus archivos." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このTodoと添付ファイルを削除します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Todo와 첨부파일이 함께 삭제됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Todo 及其附件将被删除。" } } } },

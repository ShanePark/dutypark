{
  "sourceLanguage": "en",
  "strings": {
    "calendarNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teammate access to duties and administrator or delegated access apply separately. Individual schedules also have their own visibility settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 팀원의 근무표 열람과 관리자·위임받은 사용자의 권한은 이 명단과 별도로 적용됩니다. 개인 일정은 일정별 공개 범위도 적용됩니다."
          }
        }
      }
    },
    "cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide audience"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명단 접기"
          }
        }
      }
    },
    "collapsed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapsed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힘"
          }
        }
      }
    },
    "count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} people"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{count}명"
          }
        }
      }
    },
    "empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one currently matches this audience."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 공개 범위에 해당하는 사람이 없어요."
          }
        }
      }
    },
    "error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audience could not be loaded. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명단을 불러오지 못했어요. 다시 확인해 주세요."
          }
        }
      }
    },
    "expanded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펼쳐짐"
          }
        }
      }
    },
    "family": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족"
          }
        }
      }
    },
    "familyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only people with an accepted family relationship are included."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 요청을 수락해 가족으로 연결된 사람만 포함됩니다."
          }
        }
      }
    },
    "familyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family audience"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족공개 대상"
          }
        }
      }
    },
    "friend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구"
          }
        }
      }
    },
    "friendsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current friends, including people marked as family."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 친구로 연결된 사람입니다. 가족도 포함됩니다."
          }
        }
      }
    },
    "friendsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends audience"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구공개 대상"
          }
        }
      }
    },
    "loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking who is in this audience…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 대상을 확인하고 있어요."
          }
        }
      }
    },
    "noResults": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching names."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 이름이 없어요."
          }
        }
      }
    },
    "open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View audience"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 대상 확인"
          }
        }
      }
    },
    "readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list is read-only. Viewing it does not select people or change your sharing settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인용 명단입니다. 사람을 선택하거나 공개 설정을 변경하지 않습니다."
          }
        }
      }
    },
    "relationshipNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You always have access. The audience changes when your friend or family relationships change."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 항상 확인할 수 있으며, 친구·가족 관계가 바뀌면 대상도 달라집니다."
          }
        }
      }
    },
    "restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calendar has a more restrictive visibility setting. Only people also allowed by that setting are shown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 내 캘린더 공개 설정이 더 제한적이어서, 해당 설정으로도 열람 가능한 사람만 표시합니다."
          }
        }
      }
    },
    "resultCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} of {total} people"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{total}명 중 {count}명"
          }
        }
      }
    },
    "retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        }
      }
    },
    "save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save selected visibility"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 공개 범위 저장"
          }
        }
      }
    },
    "scheduleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule tags and administrator or delegated access apply separately. This list only shows access through friend and family relationships."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 태그와 관리자·위임받은 사용자의 접근 권한은 별도입니다. 이 명단은 친구·가족 관계로 열람 가능한 대상만 보여줍니다."
          }
        }
      }
    },
    "search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름으로 찾기"
          }
        }
      }
    },
    "selectionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a visibility option, check its audience, then save."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 범위를 선택하고 명단을 확인한 뒤 저장해 주세요."
          }
        }
      }
    }
  },
  "version": "1.0"
}

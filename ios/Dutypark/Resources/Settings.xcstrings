    "settings.theme.current.dark": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current theme: Dark" } }, "es": { "stringUnit": { "state": "translated", "value": "Tema actual: Oscuro" } }, "ja": { "stringUnit": { "state": "translated", "value": "現在のテーマ：ダーク" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 테마: 다크" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前主题：深色" } } } },
    "settings.pattern.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default work pattern" } }, "es": { "stringUnit": { "state": "translated", "value": "Patrón de trabajo" } }, "ja": { "stringUnit": { "state": "translated", "value": "基本勤務パターン" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "默认工作模式" } } } },
    "settings.pattern.loadFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Failed to load the default work pattern." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo cargar el patrón." } }, "ja": { "stringUnit": { "state": "translated", "value": "基本勤務パターンを読み込めませんでした。" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 불러오지 못했습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法加载默认工作模式。" } } } },
    "settings.pattern.saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The default work pattern has been saved." } }, "es": { "stringUnit": { "state": "translated", "value": "El patrón se ha guardado." } }, "ja": { "stringUnit": { "state": "translated", "value": "基本勤務パターンを保存しました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 저장했습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "默认工作模式已保存。" } } } },
    "settings.pattern.deleted": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The default work pattern has been disabled." } }, "es": { "stringUnit": { "state": "translated", "value": "El patrón se ha desactivado." } }, "ja": { "stringUnit": { "state": "translated", "value": "基本勤務パターンを解除しました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 해제했습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "默认工作模式已停用。" } } } },
    "settings.pattern.create": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No default work pattern yet" } }, "es": { "stringUnit": { "state": "translated", "value": "Aún no hay patrón" } }, "ja": { "stringUnit": { "state": "translated", "value": "基本勤務パターンが未設定です" } }, "ko": { "stringUnit": { "state": "translated", "value": "아직 기본 근무 패턴이 없어요" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未设置默认工作模式" } } } },
    "settings.pattern.createDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Register recurring workdays to fill the calendar automatically." } }, "es": { "stringUnit": { "state": "translated", "value": "Registra días recurrentes para completar el calendario." } }, "ja": { "stringUnit": { "state": "translated", "value": "繰り返しの勤務曜日を登録するとカレンダーが自動で埋まります。" } }, "ko": { "stringUnit": { "state": "translated", "value": "반복되는 근무 요일을 등록하면 달력이 자동으로 채워집니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "登记重复工作日后，日历会自动填充。" } } } },
    "settings.pattern.edit": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit" } }, "es": { "stringUnit": { "state": "translated", "value": "Editar" } }, "ja": { "stringUnit": { "state": "translated", "value": "変更" } }, "ko": { "stringUnit": { "state": "translated", "value": "변경" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "更改" } } } },
    "settings.accessibility.on": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "On" } }, "es": { "stringUnit": { "state": "translated", "value": "Activado" } }, "ja": { "stringUnit": { "state": "translated", "value": "オン" } }, "ko": { "stringUnit": { "state": "translated", "value": "켜짐" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "开启" } } } },
    "settings.accessibility.off": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Off" } }, "es": { "stringUnit": { "state": "translated", "value": "Desactivado" } }, "ja": { "stringUnit": { "state": "translated", "value": "オフ" } }, "ko": { "stringUnit": { "state": "translated", "value": "꺼짐" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭" } } } },
    "settings.pattern.saveConfirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Save work pattern?" } }, "es": { "stringUnit": { "state": "translated", "value": "¿Guardar el patrón?" } }, "ja": { "stringUnit": { "state": "translated", "value": "勤務パターンを保存しますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "근무 패턴을 저장할까요?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "保存工作模式？" } } } },
    "settings.pattern.saveConfirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saving deletes every duty from today onward, including manual entries, and recreates them from the new weekday rules. Continue?" } }, "es": { "stringUnit": { "state": "translated", "value": "Al guardar se eliminan todos los turnos desde hoy, incluidos los manuales, y se recrean con las nuevas reglas. ¿Continuar?" } }, "ja": { "stringUnit": { "state": "translated", "value": "保存すると、手動入力を含む本日以降のすべての勤務が削除され、新しい曜日ルールで再登録されます。続行しますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "패턴을 저장하면 오늘 이후의 수동 입력을 포함한 모든 근무가 삭제되고 새 요일 규칙으로 다시 등록됩니다. 계속하시겠습니까?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "保存后，今天及之后的所有班次（包括手动输入）都会被删除，并按新的星期规则重新登记。是否继续？" } } } },
    "settings.pattern.deleteConfirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disable work pattern?" } }, "es": { "stringUnit": { "state": "translated", "value": "¿Desactivar el patrón?" } }, "ja": { "stringUnit": { "state": "translated", "value": "勤務パターンを解除しますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "근무 패턴을 해제할까요?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "停用工作模式？" } } } },
    "settings.pattern.deleteConfirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disabling the pattern deletes every duty from today onward, including manual entries. Continue?" } }, "es": { "stringUnit": { "state": "translated", "value": "Al desactivar el patrón se eliminan todos los turnos desde hoy, incluidos los manuales. ¿Continuar?" } }, "ja": { "stringUnit": { "state": "translated", "value": "パターンを解除すると、手動入力を含む本日以降のすべての勤務が削除されます。続行しますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "패턴을 해제하면 오늘 이후의 수동 입력을 포함한 모든 근무가 삭제됩니다. 계속하시겠습니까?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "停用模式后，今天及之后的所有班次（包括手动输入）都会被删除。是否继续？" } } } },
    "settings.aiConsent.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI schedule recognition" } }, "es": { "stringUnit": { "state": "translated", "value": "Reconocimiento de horarios con IA" } }, "ja": { "stringUnit": { "state": "translated", "value": "AI予定時刻認識" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 자동 인식" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 日程时间识别" } } } },
    "settings.aiConsent.toggle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Recognize times automatically" } }, "es": { "stringUnit": { "state": "translated", "value": "Reconocer horas automáticamente" } }, "ja": { "stringUnit": { "state": "translated", "value": "時刻を自動認識" } }, "ko": { "stringUnit": { "state": "translated", "value": "일정 시간 자동 인식" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动识别日程时间" } } } },
    "settings.aiConsent.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Optional. You can turn this off at any time and always enter start and end times manually." } }, "es": { "stringUnit": { "state": "translated", "value": "Opcional. Puedes desactivarlo en cualquier momento e introducir las horas manualmente." } }, "ja": { "stringUnit": { "state": "translated", "value": "任意機能です。いつでも解除でき、開始・終了時刻は常に手動入力できます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "선택 기능이며 언제든 철회할 수 있습니다. 시작·종료 시간은 항상 직접 입력할 수 있습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "此功能为可选项，可随时关闭，也始终可以手动输入开始和结束时间。" } } } },
    "settings.aiConsent.dataFlow": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "To extract a time, the schedule date and text content are sent to Google AI (Google Generative Language API). Member and team identifiers are not sent." } }, "es": { "stringUnit": { "state": "translated", "value": "Para extraer la hora, se envían la fecha y el texto del horario a Google AI (Google Generative Language API). No se envían identificadores de miembro ni de equipo." } }, "ja": { "stringUnit": { "state": "translated", "value": "時刻抽出のため、予定の日付と本文をGoogle AI（Google Generative Language API）へ送信します。会員・チーム識別子は送信しません。" } }, "ko": { "stringUnit": { "state": "translated", "value": "시간 추출을 위해 일정 날짜와 내용 텍스트를 Google AI(Google Generative Language API)에 전송합니다. 회원·팀 식별자는 전송하지 않습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "为提取时间，会将日程日期和文本内容发送至 Google AI（Google Generative Language API），不会发送会员或团队标识符。" } } } },
    "settings.aiConsent.confirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable AI time recognition?" } }, "es": { "stringUnit": { "state": "translated", "value": "¿Activar el reconocimiento de horas con IA?" } }, "ja": { "stringUnit": { "state": "translated", "value": "AI時刻認識を有効にしますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 자동 인식에 동의할까요?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用 AI 时间识别？" } } } },
    "settings.aiConsent.confirmMessage": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The schedule date and text content will be sent to Google AI (Google Generative Language API) only to extract a time. Member and team identifiers are not sent. Consent is optional and can be withdrawn at any time; manual time entry remains available." } }, "es": { "stringUnit": { "state": "translated", "value": "La fecha y el texto del horario se enviarán a Google AI (Google Generative Language API) solo para extraer la hora. No se envían identificadores de miembro ni de equipo. El consentimiento es opcional, puede retirarse en cualquier momento y la entrada manual seguirá disponible." } }, "ja": { "stringUnit": { "state": "translated", "value": "時刻抽出のみを目的に、予定の日付と本文をGoogle AI（Google Generative Language API）へ送信します。会員・チーム識別子は送信しません。同意は任意でいつでも撤回でき、手動入力も利用できます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "시간 추출만을 위해 일정 날짜와 내용 텍스트를 Google AI(Google Generative Language API)에 전송합니다. 회원·팀 식별자는 전송하지 않습니다. 동의는 선택 사항이며 언제든 철회할 수 있고, 수동 시간 입력도 계속 사용할 수 있습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅为提取时间，会将日程日期和文本内容发送至 Google AI（Google Generative Language API），不会发送会员或团队标识符。同意为可选项，可随时撤回，并可继续手动输入时间。" } } } },
    "settings.aiConsent.confirmEnable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agree and enable" } }, "es": { "stringUnit": { "state": "translated", "value": "Aceptar y activar" } }, "ja": { "stringUnit": { "state": "translated", "value": "同意して有効化" } }, "ko": { "stringUnit": { "state": "translated", "value": "동의하고 켜기" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "同意并启用" } } } },
    "settings.aiConsent.policy": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI time recognition policy" } }, "es": { "stringUnit": { "state": "translated", "value": "Política de reconocimiento con IA" } }, "ja": { "stringUnit": { "state": "translated", "value": "AI時刻認識ポリシー" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 인식 정책 자세히 보기" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 时间识别政策" } } } },
    "settings.aiConsent.renewalRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The policy changed. Consent is required again before automatic recognition." } }, "es": { "stringUnit": { "state": "translated", "value": "La política cambió. Debes volver a aceptar antes del reconocimiento automático." } }, "ja": { "stringUnit": { "state": "translated", "value": "ポリシーが変更されました。自動認識の前に再同意が必要です。" } }, "ko": { "stringUnit": { "state": "translated", "value": "정책이 변경되어 자동 인식 전에 다시 동의해야 합니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "政策已变更，自动识别前需要重新同意。" } } } },
    "settings.aiConsent.updating": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Updating AI consent" } }, "es": { "stringUnit": { "state": "translated", "value": "Actualizando el consentimiento" } }, "ja": { "stringUnit": { "state": "translated", "value": "AI同意を更新中" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의 상태 변경 중" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在更新 AI 同意状态" } } } },
    "settings.aiConsent.loadFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not load AI consent. Automatic recognition stays off; manual time entry is available." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo cargar el consentimiento. El reconocimiento queda desactivado y puedes introducir la hora manualmente." } }, "ja": { "stringUnit": { "state": "translated", "value": "AI同意を読み込めませんでした。自動認識はオフのままで、時刻は手動入力できます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의 상태를 불러오지 못했습니다. 자동 인식은 꺼진 상태이며 시간을 직접 입력할 수 있습니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法加载 AI 同意状态。自动识别保持关闭，您仍可手动输入时间。" } } } },
    "settings.aiConsent.enableFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI consent could not be saved. Automatic recognition stays off." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo guardar el consentimiento. El reconocimiento automático sigue desactivado." } }, "ja": { "stringUnit": { "state": "translated", "value": "AI同意を保存できませんでした。自動認識はオフのままです。" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의를 저장하지 못했습니다. 자동 인식은 꺼진 상태로 유지됩니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存 AI 同意，自动识别保持关闭。" } } } },
    "settings.aiConsent.disableFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI consent could not be withdrawn. Please try again." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo retirar el consentimiento. Inténtalo de nuevo." } }, "ja": { "stringUnit": { "state": "translated", "value": "AI同意を撤回できませんでした。もう一度お試しください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의를 철회하지 못했습니다. 다시 시도해 주세요." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法撤回 AI 同意，请重试。" } } } }
  },
  "version": "1.0"
}

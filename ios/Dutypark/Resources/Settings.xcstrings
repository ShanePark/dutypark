{
  "sourceLanguage": "en",
  "strings": {
    "settings.accountDeletion.accepted.confirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Continue" } }, "ko": { "stringUnit": { "state": "translated", "value": "확인" } } } },
    "settings.accountDeletion.accepted.dismiss": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Close" } }, "ko": { "stringUnit": { "state": "translated", "value": "닫기" } } } },
    "settings.accountDeletion.accepted.eta": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Deletion is usually completed within 5 minutes." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제는 보통 5분 이내에 완료됩니다." } } } },
    "settings.accountDeletion.accepted.loggedOut": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You have been safely signed out of Dutypark." } }, "ko": { "stringUnit": { "state": "translated", "value": "Dutypark에서 안전하게 로그아웃되었습니다." } } } },
    "settings.accountDeletion.accepted.noAction": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No retry or support inquiry is needed. We will finish the deletion automatically." } }, "ko": { "stringUnit": { "state": "translated", "value": "다시 요청하거나 문의할 필요가 없습니다. 삭제는 자동으로 완료됩니다." } } } },
    "settings.accountDeletion.accepted.processing": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your account data and files are being deleted in the background. This may take some time." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 데이터와 파일은 비동기로 삭제 중이며 완료까지 시간이 걸릴 수 있습니다." } } } },
    "settings.accountDeletion.accepted.retry": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Check again" } }, "ko": { "stringUnit": { "state": "translated", "value": "다시 확인" } } } },
    "settings.accountDeletion.accepted.statusUnavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "We could not check the status temporarily. We will keep trying." } }, "ko": { "stringUnit": { "state": "translated", "value": "일시적으로 상태를 확인하지 못했습니다. 계속 다시 확인합니다." } } } },
    "settings.accountDeletion.accepted.support": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Contact support" } }, "ko": { "stringUnit": { "state": "translated", "value": "문의하기" } } } },
    "settings.accountDeletion.accepted.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Deletion request received" } }, "ko": { "stringUnit": { "state": "translated", "value": "탈퇴 요청이 접수되었습니다" } } } },
    "settings.accountDeletion.completed.confirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Done" } }, "ko": { "stringUnit": { "state": "translated", "value": "확인" } } } },
    "settings.accountDeletion.completed.details": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Processing is complete for the account data and files identified for deletion on the deletion screen." } }, "ko": { "stringUnit": { "state": "translated", "value": "탈퇴 화면에서 삭제 대상으로 안내한 계정 데이터와 파일의 처리가 완료되었습니다." } } } },
    "settings.accountDeletion.completed.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Account deletion is complete." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제가 완료되었습니다." } } } },
    "settings.accountDeletion.completed.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Account deleted" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제 완료" } } } },
    "settings.accountDeletion.expired.details": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This status receipt is no longer available. Contact support if you need help confirming your deletion." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 상태 영수증을 더 이상 확인할 수 없습니다. 삭제 확인이 필요하면 문의해주세요." } } } },
    "settings.accountDeletion.expired.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "We could not confirm the final deletion status." } }, "ko": { "stringUnit": { "state": "translated", "value": "최종 삭제 상태를 확인할 수 없습니다." } } } },
    "settings.accountDeletion.expired.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Deletion status unavailable" } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 상태 확인 불가" } } } },
    "settings.accountDeletion.failed.details": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The deletion could not be completed. Contact support so we can help resolve it." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제를 완료하지 못했습니다. 해결을 위해 문의해주세요." } } } },
    "settings.accountDeletion.failed.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Please contact support for help with your deletion request." } }, "ko": { "stringUnit": { "state": "translated", "value": "탈퇴 요청 해결을 위해 문의해주세요." } } } },
    "settings.accountDeletion.failed.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Deletion needs attention" } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 처리에 확인이 필요합니다" } } } },
    "settings.accountDeletion.unavailable.details": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "We could not verify the deletion status. Contact support if this continues." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 상태를 확인하지 못했습니다. 계속되면 문의해주세요." } } } },
    "settings.accountDeletion.unavailable.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The deletion status response was not recognized." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 상태 응답을 확인할 수 없습니다." } } } },
    "settings.accountDeletion.unavailable.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Deletion status unavailable" } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 상태 확인 불가" } } } },
    "settings.account.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 탈퇴"
          }
        }
      }
    },
    "settings.account.deleteInfo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please contact the administrator to delete your account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 탈퇴는 관리자에게 문의해주세요."
          }
        }
      }
    },
    "settings.accountDeletion.back": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Back" } }, "ko": { "stringUnit": { "state": "translated", "value": "이전" } } } },
    "settings.accountDeletion.continue": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Continue" } }, "ko": { "stringUnit": { "state": "translated", "value": "계속" } } } },
    "settings.accountDeletion.error.alreadyPending": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Account deletion has already been requested and is being processed." } }, "ko": { "stringUnit": { "state": "translated", "value": "이미 계정 삭제가 요청되어 처리 중입니다." } } } },
    "settings.accountDeletion.error.appleAccountMismatch": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This Apple account does not match the account being verified." } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 확인 중인 계정과 Apple 계정이 일치하지 않습니다." } } } },
    "settings.accountDeletion.error.appleConfigurationUnavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sign in with Apple is not available yet. Please use another verification method." } }, "ko": { "stringUnit": { "state": "translated", "value": "Apple 로그인을 아직 사용할 수 없습니다. 다른 본인 확인 방법을 이용해주세요." } } } },
    "settings.accountDeletion.error.appleCredentialInvalid": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The Apple sign-in response is invalid or expired. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "Apple 로그인 응답이 올바르지 않거나 만료되었습니다. 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.appleProviderUnavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apple sign-in is temporarily unavailable. Please try again later." } }, "ko": { "stringUnit": { "state": "translated", "value": "Apple 로그인을 일시적으로 사용할 수 없습니다. 잠시 후 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.generic": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not request account deletion. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제를 요청하지 못했습니다. 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.impersonation": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You cannot delete an account while impersonating another user." } }, "ko": { "stringUnit": { "state": "translated", "value": "다른 사용자로 전환한 상태에서는 계정을 삭제할 수 없습니다." } } } },
    "settings.accountDeletion.error.load": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not load account deletion details. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제 정보를 불러오지 못했습니다. 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.nameMismatch": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The name you entered does not match." } }, "ko": { "stringUnit": { "state": "translated", "value": "입력한 이름이 일치하지 않습니다." } } } },
    "settings.accountDeletion.error.noTransferCandidate": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "There is no eligible member to receive administrator privileges." } }, "ko": { "stringUnit": { "state": "translated", "value": "관리자 권한을 넘겨받을 수 있는 팀원이 없습니다." } } } },
    "settings.accountDeletion.error.proofExpired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your verification has expired. Please verify your identity again." } }, "ko": { "stringUnit": { "state": "translated", "value": "본인 확인이 만료되었습니다. 다시 본인 확인을 진행해주세요." } } } },
    "settings.accountDeletion.error.reauthentication": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not verify your identity. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "본인 확인에 실패했습니다. 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.receiptOtherAccount": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A deletion status from another account is still saved on this device. Sign out and check that status before deleting this account." } }, "ko": { "stringUnit": { "state": "translated", "value": "이 기기에 다른 계정의 탈퇴 상태가 아직 저장되어 있습니다. 로그아웃하여 해당 상태를 확인한 후 이 계정을 탈퇴해주세요." } } } },
    "settings.accountDeletion.error.receiptStorage": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not securely prepare the deletion request. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 요청을 안전하게 준비하지 못했습니다. 다시 시도해주세요." } } } },
    "settings.accountDeletion.error.transferInvalid": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The selected member cannot receive administrator privileges. Choose another member." } }, "ko": { "stringUnit": { "state": "translated", "value": "선택한 팀원에게 관리자 권한을 이관할 수 없습니다. 다른 팀원을 선택해주세요." } } } },
    "settings.accountDeletion.error.transferRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose a member to receive administrator privileges." } }, "ko": { "stringUnit": { "state": "translated", "value": "관리자 권한을 넘겨받을 팀원을 선택해주세요." } } } },
    "settings.accountDeletion.final.action": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Permanently delete account" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 영구 삭제" } } } },
    "settings.accountDeletion.final.irreversible": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Once processing starts, your account, related files, and any team scheduled for deletion cannot be recovered." } }, "ko": { "stringUnit": { "state": "translated", "value": "처리가 시작되면 계정과 관련 파일, 삭제 대상 팀을 복구할 수 없습니다." } } } },
    "settings.accountDeletion.final.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your deletion request takes effect immediately and cannot be canceled." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제 요청은 즉시 적용되며 취소할 수 없습니다." } } } },
    "settings.accountDeletion.final.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Final confirmation" } }, "ko": { "stringUnit": { "state": "translated", "value": "최종 확인" } } } },
    "settings.accountDeletion.loading": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Loading account information…" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 정보를 불러오는 중…" } } } },
    "settings.accountDeletion.name.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "To confirm, enter your name exactly as shown below." } }, "ko": { "stringUnit": { "state": "translated", "value": "확인을 위해 아래 표시된 이름을 똑같이 입력해주세요." } } } },
    "settings.accountDeletion.name.placeholder": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enter your name" } }, "ko": { "stringUnit": { "state": "translated", "value": "이름 입력" } } } },
    "settings.accountDeletion.name.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Confirm your name" } }, "ko": { "stringUnit": { "state": "translated", "value": "이름 확인" } } } },
    "settings.accountDeletion.progress": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Account deletion progress" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제 진행 단계" } } } },
    "settings.accountDeletion.reauth.complete": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Identity verified" } }, "ko": { "stringUnit": { "state": "translated", "value": "본인 확인 완료" } } } },
    "settings.accountDeletion.reauth.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Verify your identity again to protect your account before continuing." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정을 보호하기 위해 계속하기 전에 본인 확인을 다시 진행해주세요." } } } },
    "settings.accountDeletion.reauth.password": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current password" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 비밀번호" } } } },
    "settings.accountDeletion.reauth.passwordAction": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Verify with password" } }, "ko": { "stringUnit": { "state": "translated", "value": "비밀번호로 확인" } } } },
    "settings.accountDeletion.reauth.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Verify your identity" } }, "ko": { "stringUnit": { "state": "translated", "value": "본인 확인" } } } },
    "settings.accountDeletion.scope.access": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You will lose access immediately after requesting deletion." } }, "ko": { "stringUnit": { "state": "translated", "value": "삭제를 요청하면 즉시 계정에 접근할 수 없게 됩니다." } } } },
    "settings.accountDeletion.scope.async": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your account and related files will be deleted asynchronously. This may take some time." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정과 관련 파일은 비동기로 삭제되며 처리에 시간이 걸릴 수 있습니다." } } } },
    "settings.accountDeletion.scope.auxiliary": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The following linked accounts will also be deleted:" } }, "ko": { "stringUnit": { "state": "translated", "value": "다음 연결 계정도 함께 삭제됩니다:" } } } },
    "settings.accountDeletion.scope.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Review what happens when your account is deleted." } }, "ko": { "stringUnit": { "state": "translated", "value": "계정을 삭제하면 어떻게 처리되는지 확인해주세요." } } } },
    "settings.accountDeletion.scope.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Before you continue" } }, "ko": { "stringUnit": { "state": "translated", "value": "계속하기 전에" } } } },
    "settings.accountDeletion.team.memberOnly": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You will leave this team. The team itself will remain." } }, "ko": { "stringUnit": { "state": "translated", "value": "이 팀에서 탈퇴하며 팀 자체는 유지됩니다." } } } },
    "settings.accountDeletion.team.none": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You do not belong to a team." } }, "ko": { "stringUnit": { "state": "translated", "value": "소속된 팀이 없습니다." } } } },
    "settings.accountDeletion.team.select": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Select a member" } }, "ko": { "stringUnit": { "state": "translated", "value": "팀원 선택" } } } },
    "settings.accountDeletion.team.soloDelete": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Since you are the only team member, the team and its data will also be deleted." } }, "ko": { "stringUnit": { "state": "translated", "value": "혼자 있는 팀이므로 팀과 팀 데이터도 함께 삭제됩니다." } } } },
    "settings.accountDeletion.team.successor": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "New administrator" } }, "ko": { "stringUnit": { "state": "translated", "value": "새 관리자" } } } },
    "settings.accountDeletion.team.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Team impact" } }, "ko": { "stringUnit": { "state": "translated", "value": "팀 처리" } } } },
    "settings.accountDeletion.team.transferRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You are this team's administrator. Choose a member to transfer administrator privileges to." } }, "ko": { "stringUnit": { "state": "translated", "value": "이 팀의 관리자입니다. 관리자 권한을 넘겨받을 팀원을 선택해주세요." } } } },
    "settings.accountDeletion.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Delete account" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정 삭제" } } } },
    "settings.account.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Management"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원정보 관리"
          }
        }
      }
    },
    "settings.action.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "settings.action.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "settings.action.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        }
      }
    },
    "settings.action.create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        },
        "ko": {

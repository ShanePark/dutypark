    "settings.push.permissionMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications to receive schedule, friend, and todo updates."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정, 친구, 할 일 소식을 받으려면 알림을 허용해주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定、友達、Todoの更新を受け取るには通知を許可してください。"

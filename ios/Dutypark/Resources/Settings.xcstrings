    "settings.sessions.revokeMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign out? This device will be signed out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 로그아웃 하시겠습니까? 해당 기기에서 로그아웃 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトしますか？この端末のセッションが終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要退出吗？此设备上的会话将结束。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres cerrar sesión? Se cerrará la sesión en este dispositivo."
          }
        }
      }
    },
    "settings.sessions.revokeOthers": {
      "localizations": {

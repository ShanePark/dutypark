    "settings.auxiliary.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a name-only account for a separate schedule. Up to 10 characters."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 시간표에 사용할 이름 전용 계정을 생성합니다. 최대 10자입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の予定表に使用する名前のみのアカウントを作成します。最大10文字です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建仅有姓名的账户用于单独日程。最多10个字符。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta solo con nombre para otro horario. Máximo 10 caracteres."
          }
        }
      }
    },

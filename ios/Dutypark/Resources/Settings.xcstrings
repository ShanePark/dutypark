{
  "sourceLanguage": "en",
  "strings": {
    "settings.account.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 탈퇴"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销账户"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar cuenta"
          }
        }
      }
    },
    "settings.account.deleteInfo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please contact the administrator to delete your account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 탈퇴는 관리자에게 문의해주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除は管理者にお問い合わせください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需注销账户，请联系管理员。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacta con el administrador para eliminar tu cuenta."
          }
        }
      }
    },

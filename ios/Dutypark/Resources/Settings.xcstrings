    "settings.visibility.modalTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose schedule visibility" } }, "es": { "stringUnit": { "state": "translated", "value": "Visibilidad del horario" } }, "ja": { "stringUnit": { "state": "translated", "value": "公開範囲を選択" } }, "ko": { "stringUnit": { "state": "translated", "value": "시간표 공개 대상 설정" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择日程可见性" } } } },
    "settings.visibility.modalDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Set who can view your calendar." } }, "es": { "stringUnit": { "state": "translated", "value": "Establece quién puede ver tu calendario." } }, "ja": { "stringUnit": { "state": "translated", "value": "カレンダーを見られる相手を設定してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "내 달력을 공개할 범위를 설정하세요." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "设置谁可以查看您的日历。" } } } },
    "settings.visibility.modalHint": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Changes are saved immediately when selected." } }, "es": { "stringUnit": { "state": "translated", "value": "Los cambios se guardan al seleccionar." } }, "ja": { "stringUnit": { "state": "translated", "value": "選択するとすぐに保存されます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "선택시 변경사항이 즉시 저장됩니다." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择后立即保存更改。" } } } },
    "settings.visibility.close": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Close" } }, "es": { "stringUnit": { "state": "translated", "value": "Cerrar" } }, "ja": { "stringUnit": { "state": "translated", "value": "閉じる" } }, "ko": { "stringUnit": { "state": "translated", "value": "닫기" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭" } } } },
    "settings.visibility.public.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Anyone can view your schedule." } }, "es": { "stringUnit": { "state": "translated", "value": "Cualquiera puede ver tu horario." } }, "ja": { "stringUnit": { "state": "translated", "value": "誰でも予定を確認できます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "모든 사용자가 내 시간표를 볼 수 있습니다" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "任何人都可以查看您的日程。" } } } },
    "settings.visibility.friends.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only confirmed friends can view your schedule." } }, "es": { "stringUnit": { "state": "translated", "value": "Solo los amigos pueden ver tu horario." } }, "ja": { "stringUnit": { "state": "translated", "value": "承認済みの友だちだけが確認できます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "친구로 등록된 사용자만 볼 수 있습니다" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "只有确认的好友才能查看您的日程。" } } } },

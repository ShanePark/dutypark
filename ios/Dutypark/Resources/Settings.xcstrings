        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auxiliary account created."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 계정을 생성했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補助アカウントを作成しました。"

    "settings.profile.name": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Name" } }, "ko": { "stringUnit": { "state": "translated", "value": "이름" } } } },
    "settings.profile.team": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Team" } }, "ko": { "stringUnit": { "state": "translated", "value": "소속" } } } },
    "settings.profile.email": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Email" } }, "ko": { "stringUnit": { "state": "translated", "value": "이메일" } } } },
    "settings.visibility.current": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current audience" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 공개 대상" } } } },
    "settings.visibility.modalTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose schedule visibility" } }, "ko": { "stringUnit": { "state": "translated", "value": "시간표 공개 대상 설정" } } } },
    "settings.visibility.modalDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Set who can view your calendar." } }, "ko": { "stringUnit": { "state": "translated", "value": "내 달력을 공개할 범위를 설정하세요." } } } },
    "settings.visibility.modalHint": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Changes are saved immediately when selected." } }, "ko": { "stringUnit": { "state": "translated", "value": "선택시 변경사항이 즉시 저장됩니다." } } } },
    "settings.visibility.close": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Close" } }, "ko": { "stringUnit": { "state": "translated", "value": "닫기" } } } },
    "settings.visibility.public.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Anyone can view your schedule." } }, "ko": { "stringUnit": { "state": "translated", "value": "모든 사용자가 내 시간표를 볼 수 있습니다" } } } },
    "settings.visibility.friends.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only confirmed friends can view your schedule." } }, "ko": { "stringUnit": { "state": "translated", "value": "친구로 등록된 사용자만 볼 수 있습니다" } } } },
    "settings.visibility.family.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only family connections can view your schedule." } }, "ko": { "stringUnit": { "state": "translated", "value": "가족으로 등록된 사용자만 볼 수 있습니다" } } } },
    "settings.visibility.private.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only you can view your schedule." } }, "ko": { "stringUnit": { "state": "translated", "value": "나만 볼 수 있습니다" } } } },
    "settings.theme.system": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "System" } }, "ko": { "stringUnit": { "state": "translated", "value": "시스템" } } } },
    "settings.theme.current.system": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current theme: System" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 테마: 시스템 설정" } } } },
    "settings.theme.current.light": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current theme: Light" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 테마: 라이트" } } } },
    "settings.theme.current.dark": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current theme: Dark" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 테마: 다크" } } } },
    "settings.pattern.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default work pattern" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴" } } } },
    "settings.pattern.loadFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Failed to load the default work pattern." } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 불러오지 못했습니다." } } } },
    "settings.pattern.saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The default work pattern has been saved." } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 저장했습니다." } } } },
    "settings.pattern.deleted": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The default work pattern has been disabled." } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 근무 패턴을 해제했습니다." } } } },
    "settings.pattern.create": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No default work pattern yet" } }, "ko": { "stringUnit": { "state": "translated", "value": "아직 기본 근무 패턴이 없어요" } } } },
    "settings.pattern.createDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Register recurring workdays to fill the calendar automatically." } }, "ko": { "stringUnit": { "state": "translated", "value": "반복되는 근무 요일을 등록하면 달력이 자동으로 채워집니다." } } } },
    "settings.pattern.edit": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit" } }, "ko": { "stringUnit": { "state": "translated", "value": "변경" } } } },
    "settings.pattern.hidden": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Hidden" } }, "ko": { "stringUnit": { "state": "translated", "value": "숨김" } } } },
    "settings.pattern.paused.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Some weekdays are temporarily paused." } }, "ko": { "stringUnit": { "state": "translated", "value": "일부 요일의 자동 적용이 중지되었습니다." } } } },
    "settings.pattern.paused.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Weekdays assigned to hidden duty types remain paused until you select another type or restore the hidden type." } }, "ko": { "stringUnit": { "state": "translated", "value": "숨겨진 근무 유형이 지정된 요일은 다른 유형을 선택하거나 해당 유형을 복원할 때까지 적용되지 않습니다." } } } },
    "settings.pattern.unavailable.team": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only members assigned to a team can configure a default work pattern." } }, "ko": { "stringUnit": { "state": "translated", "value": "팀에 소속된 회원만 기본 근무 패턴을 설정할 수 있습니다." } } } },
    "settings.pattern.unavailable.dutyType": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add at least one visible team duty type to use this setting." } }, "ko": { "stringUnit": { "state": "translated", "value": "팀에 보이는 근무 유형을 하나 이상 등록하면 사용할 수 있습니다." } } } },
    "settings.pattern.unavailable.default": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Check the team duty type settings." } }, "ko": { "stringUnit": { "state": "translated", "value": "팀 근무 유형 설정을 확인해주세요." } } } },
    "settings.accessibility.on": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "On" } }, "ko": { "stringUnit": { "state": "translated", "value": "켜짐" } } } },
    "settings.accessibility.off": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Off" } }, "ko": { "stringUnit": { "state": "translated", "value": "꺼짐" } } } },
    "settings.pattern.saveConfirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Save work pattern?" } }, "ko": { "stringUnit": { "state": "translated", "value": "근무 패턴을 저장할까요?" } } } },
    "settings.pattern.saveConfirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saving deletes every duty from today onward, including manual entries, and recreates them from the new weekday rules. Continue?" } }, "ko": { "stringUnit": { "state": "translated", "value": "패턴을 저장하면 오늘 이후의 수동 입력을 포함한 모든 근무가 삭제되고 새 요일 규칙으로 다시 등록됩니다. 계속하시겠습니까?" } } } },
    "settings.pattern.deleteConfirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disable work pattern?" } }, "ko": { "stringUnit": { "state": "translated", "value": "근무 패턴을 해제할까요?" } } } },
    "settings.pattern.deleteConfirm": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disabling the pattern deletes every duty from today onward, including manual entries. Continue?" } }, "ko": { "stringUnit": { "state": "translated", "value": "패턴을 해제하면 오늘 이후의 수동 입력을 포함한 모든 근무가 삭제됩니다. 계속하시겠습니까?" } } } },
    "settings.aiConsent.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic AI time recognition" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 자동 인식" } } } },
    "settings.aiConsent.toggle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Recognize times automatically" } }, "ko": { "stringUnit": { "state": "translated", "value": "일정 시간 자동 인식" } } } },
    "settings.aiConsent.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This is optional and can be withdrawn at any time. You can still save schedules unchanged or enter times manually without consenting." } }, "ko": { "stringUnit": { "state": "translated", "value": "선택 동의이며 언제든 철회할 수 있습니다. 동의하지 않아도 일정을 그대로 저장하거나 시간을 직접 입력할 수 있습니다." } } } },
    "settings.aiConsent.dataFlow": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only the schedule date and content text are sent to an external AI processing service to extract start and end times. Member and team IDs are not sent." } }, "ko": { "stringUnit": { "state": "translated", "value": "일정의 날짜와 내용 텍스트만 외부 AI 처리 서비스로 전송해 시작·종료 시간을 추출합니다. 회원 ID와 팀 ID는 전송하지 않습니다." } } } },
    "settings.aiConsent.effectiveDate": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Effective date:" } }, "ko": { "stringUnit": { "state": "translated", "value": "시행일:" } } } },
    "settings.aiConsent.confirmAcknowledgement": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "I have reviewed and agree to the terms above" } }, "ko": { "stringUnit": { "state": "translated", "value": "위 약관을 확인했고 동의합니다" } } } },
    "settings.aiConsent.confirmAcknowledgementHint": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Required before AI time recognition can be enabled." } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 자동 인식을 켜려면 반드시 선택해야 합니다." } } } },
    "settings.aiConsent.confirmTitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable AI time recognition?" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 자동 인식에 동의할까요?" } } } },
    "settings.aiConsent.confirmMessage": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The schedule date and text content will be sent to an external AI processing service only to extract a time. Member and team identifiers are not sent. Consent is optional and can be withdrawn at any time; manual time entry remains available." } }, "ko": { "stringUnit": { "state": "translated", "value": "시간 추출만을 위해 일정 날짜와 내용 텍스트를 외부 AI 처리 서비스로 전송합니다. 회원·팀 식별자는 전송하지 않습니다. 동의는 선택 사항이며 언제든 철회할 수 있고, 수동 시간 입력도 계속 사용할 수 있습니다." } } } },
    "settings.aiConsent.confirmEnable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agree and enable" } }, "ko": { "stringUnit": { "state": "translated", "value": "동의하고 켜기" } } } },
    "settings.aiConsent.confirmEnableHint": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saves consent for the current policy version and enables AI time recognition." } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 정책 버전에 대한 동의를 저장하고 AI 시간 자동 인식을 켭니다." } } } },
    "settings.aiConsent.policy": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI time recognition policy" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 시간 인식 정책 자세히 보기" } } } },
    "settings.aiConsent.policyVersion": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Policy version:" } }, "ko": { "stringUnit": { "state": "translated", "value": "정책 버전:" } } } },
    "settings.aiConsent.renewalRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The policy changed. Consent is required again before automatic recognition." } }, "ko": { "stringUnit": { "state": "translated", "value": "정책이 변경되어 자동 인식 전에 다시 동의해야 합니다." } } } },
    "settings.aiConsent.updating": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Updating AI consent" } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의 상태 변경 중" } } } },
    "settings.aiConsent.loadFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not load AI consent. Automatic recognition stays off; manual time entry is available." } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의 상태를 불러오지 못했습니다. 자동 인식은 꺼진 상태이며 시간을 직접 입력할 수 있습니다." } } } },
    "settings.aiConsent.enableFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI consent could not be saved. Automatic recognition stays off." } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의를 저장하지 못했습니다. 자동 인식은 꺼진 상태로 유지됩니다." } } } },
    "settings.aiConsent.disableFailed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI consent could not be withdrawn. Please try again." } }, "ko": { "stringUnit": { "state": "translated", "value": "AI 동의를 철회하지 못했습니다. 다시 시도해 주세요." } } } }
  },
  "version": "1.0"
}

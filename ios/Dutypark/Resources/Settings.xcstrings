      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social accounts cannot be disconnected while using another account through account switching. Return to your own account first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 전환으로 다른 계정에 접속 중에는 소셜 연결을 해제할 수 없습니다. 먼저 본인 계정으로 돌아가 주세요."
          }
        }
      }
    },

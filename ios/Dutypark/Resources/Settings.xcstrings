    },
    "settings.sessions.revokeOthersMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sign out {count} other devices while keeping your current session. Continue?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 접속을 제외한 {count}개의 다른 기기에서 모두 로그아웃 됩니다. 진행하시겠습니까?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のセッションを除くほかの{count}台の端末からログアウトします。続けますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将退出当前会话以外的 {count} 台设备。是否继续？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión en {count} dispositivos, excepto en la sesión actual. ¿Continuar?"
          }
        }
      }

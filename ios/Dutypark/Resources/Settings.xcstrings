    "settings.managed.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to an account you manage or create an auxiliary account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 중인 계정으로 전환하거나 보조 계정을 생성할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理中のアカウントに切り替えるか、補助アカウントを作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可切换到您管理的账户或创建辅助账户。"

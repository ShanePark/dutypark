    "duty.pattern.team.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must belong to a team to configure a default duty pattern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀에 소속된 회원만 기본 근무 패턴을 설정할 수 있습니다."
          }

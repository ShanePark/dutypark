{
  "sourceLanguage": "en",
  "strings": {
    "already_linked": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social account is already connected to another account." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이미 다른 계정에 연결된 소셜 계정입니다." } }
      }
    },
    "auth.oauth.mobile.authorizationUrl.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not start social login. Please try again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인을 시작하지 못했습니다. 다시 시도해주세요." } }
      }
    },
    "auth.oauth.mobile.callback.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login response is invalid. Please try again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 응답이 올바르지 않습니다. 다시 시도해주세요." } }
      }
    },
    "auth.oauth.mobile.callback.notAllowed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login callback address is not allowed." } },
        "ko": { "stringUnit": { "state": "translated", "value": "허용되지 않은 소셜 로그인 콜백 주소입니다." } }
      }
    },
    "auth.oauth.mobile.code.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login code is invalid or expired. Please start again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 코드가 올바르지 않거나 만료되었습니다. 처음부터 다시 시도해주세요." } }
      }
    },
    "auth.oauth.mobile.pkce.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Social login security verification failed. Please start again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 보안 확인에 실패했습니다. 처음부터 다시 시도해주세요." } }
      }
    },
    "auth.oauth.mobile.provider.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social login provider is not supported." } },
        "ko": { "stringUnit": { "state": "translated", "value": "지원하지 않는 소셜 로그인 제공자입니다." } }
      }
    },
    "auth.oauth.mobile.purpose.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social login request is not supported." } },
        "ko": { "stringUnit": { "state": "translated", "value": "지원하지 않는 소셜 로그인 요청입니다." } }
      }
    },
    "auth.oauth.mobile.state.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login session is invalid or expired. Please start again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 세션이 올바르지 않거나 만료되었습니다. 처음부터 다시 시도해주세요." } }
      }
    },
    "provider_failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login provider could not complete authentication. Please try again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 제공자 인증에 실패했습니다. 다시 시도해주세요." } }
      }
    },
    "attachment.context.missing": {
      "localizations": {

{
  "sourceLanguage": "en",
  "strings": {
    "already_linked": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social account is already connected to another account." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta cuenta social ya está conectada a otra cuenta." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このソーシャルアカウントはすでに別のアカウントに連携されています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이미 다른 계정에 연결된 소셜 계정입니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此社交账号已关联到其他账号。" } }
      }
    },
    "auth.oauth.mobile.authorizationUrl.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not start social login. Please try again." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo iniciar el acceso social. Inténtalo de nuevo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインを開始できませんでした。もう一度お試しください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인을 시작하지 못했습니다. 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法启动社交账号登录，请重试。" } }
      }
    },
    "auth.oauth.mobile.callback.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login response is invalid. Please try again." } },
        "es": { "stringUnit": { "state": "translated", "value": "La respuesta del acceso social no es válida. Inténtalo de nuevo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインの応答が無効です。もう一度お試しください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 응답이 올바르지 않습니다. 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "社交账号登录响应无效，请重试。" } }
      }
    },
    "auth.oauth.mobile.callback.notAllowed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login callback address is not allowed." } },
        "es": { "stringUnit": { "state": "translated", "value": "La dirección de retorno del acceso social no está permitida." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインのコールバック先が許可されていません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "허용되지 않은 소셜 로그인 콜백 주소입니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "不允许使用此社交账号登录回调地址。" } }
      }
    },
    "auth.oauth.mobile.code.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login code is invalid or expired. Please start again." } },
        "es": { "stringUnit": { "state": "translated", "value": "El código de acceso social no es válido o ha caducado. Vuelve a empezar." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインコードが無効か期限切れです。最初からやり直してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 코드가 올바르지 않거나 만료되었습니다. 처음부터 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "社交账号登录代码无效或已过期，请重新开始。" } }
      }
    },
    "auth.oauth.mobile.pkce.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Social login security verification failed. Please start again." } },
        "es": { "stringUnit": { "state": "translated", "value": "Falló la verificación de seguridad del acceso social. Vuelve a empezar." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインのセキュリティ確認に失敗しました。最初からやり直してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 보안 확인에 실패했습니다. 처음부터 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "社交账号登录安全验证失败，请重新开始。" } }
      }
    },
    "auth.oauth.mobile.provider.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social login provider is not supported." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este proveedor de acceso social no es compatible." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このソーシャルログインには対応していません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지원하지 않는 소셜 로그인 제공자입니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "不支持此社交账号登录提供商。" } }
      }
    },
    "auth.oauth.mobile.purpose.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This social login request is not supported." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta solicitud de acceso social no es compatible." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このソーシャルログイン要求には対応していません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지원하지 않는 소셜 로그인 요청입니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "不支持此社交账号登录请求。" } }
      }
    },
    "auth.oauth.mobile.state.invalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login session is invalid or expired. Please start again." } },
        "es": { "stringUnit": { "state": "translated", "value": "La sesión de acceso social no es válida o ha caducado. Vuelve a empezar." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインセッションが無効か期限切れです。最初からやり直してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 세션이 올바르지 않거나 만료되었습니다. 처음부터 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "社交账号登录会话无效或已过期，请重新开始。" } }
      }
    },
    "provider_failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The social login provider could not complete authentication. Please try again." } },
        "es": { "stringUnit": { "state": "translated", "value": "El proveedor de acceso social no pudo completar la autenticación. Inténtalo de nuevo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ソーシャルログインの認証に失敗しました。もう一度お試しください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "소셜 로그인 제공자 인증에 실패했습니다. 다시 시도해주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "社交账号登录提供商未能完成认证，请重试。" } }
      }
    },
    "attachment.context.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment context information is missing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부파일의 컨텍스트 정보가 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのコンテキスト情報がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少附件上下文信息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la información del contexto del archivo adjunto."
          }
        }
      }
    },
    "attachment.extension.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file extension is not allowed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되지 않는 파일 확장자입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていないファイル拡張子です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许使用此文件扩展名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta extensión de archivo no está permitida."
          }
        }
      }
    },
    "attachment.profile.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to modify this profile attachment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필 첨부파일을 수정할 권한이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィール添付ファイルを変更する権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权修改此个人资料附件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para modificar este archivo adjunto de perfil."
          }
        }
      }
    },
    "attachment.session.auth.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login is required to access session attachments."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 업로드 세션 첨부파일에 접근하려면 로그인이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時アップロードセッションの添付ファイルにアクセスするにはログインが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要登录才能访问会话附件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario iniciar sesión para acceder a los archivos adjuntos de la sesión."
          }
        }
      }
    },
    "attachment.session.contextMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload session does not match the target context."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 세션과 대상 컨텍스트가 일치하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードセッションと対象コンテキストが一致しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传会话与目标上下文不匹配。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de carga no coincide con el contexto de destino."
          }
        }
      }
    },
    "attachment.session.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to access this upload session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업로드 세션에 접근할 권한이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップロードセッションにアクセスする権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权访问此上传会话。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para acceder a esta sesión de carga."
          }
        }
      }
    },
    "attachment.session.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload session for this attachment could not be found."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 첨부파일에 연결된 업로드 세션을 찾을 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この添付ファイルに紐づくアップロードセッションが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此附件的上传会话。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar la sesión de carga de este archivo adjunto."
          }
        }
      }
    },
    "attachment.session.targetContext.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload session is missing target context information."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 세션의 대상 컨텍스트 정보가 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードセッションに対象コンテキスト情報がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传会话缺少目标上下文信息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la sesión de carga le falta información del contexto de destino."
          }
        }
      }
    },
    "attachment.size.exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 크기가 너무 큽니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルサイズが大きすぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件太大。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande."
          }
        }
      }
    },
    "attachment.todo.access.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to view this to-do attachment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일 첨부파일을 볼 권한이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このTo-do添付ファイルを閲覧する権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权查看此待办事项附件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para ver este archivo adjunto de tareas pendientes."
          }
        }
      }
    },
    "attachment.todo.auth.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login is required to access this to-do attachment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일 첨부파일에 접근하려면 로그인이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このTo-do添付ファイルにアクセスするにはログインが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要登录才能访问此待办事项附件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario iniciar sesión para acceder a este archivo adjunto de tareas pendientes."
          }
        }
      }
    },
    "attachment.todo.write.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to modify this to-do attachment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일 첨부파일을 수정할 권한이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このTo-do添付ファイルを変更する権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权修改此待办事项附件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para modificar este archivo adjunto de tareas pendientes."
          }
        }
      }
    },
    "auth.impersonation.alreadyImpersonating": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are already impersonating another account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 다른 계정으로 전환된 상태입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに別のアカウントに切り替え中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已经在冒充另一个帐户。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya estás haciéndote pasar por otra cuenta."
          }
        }
      }
    },
    "auth.impersonation.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to switch accounts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 전환에 실패했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント切り替えに失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换账户失败。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar de cuenta."
          }
        }
      }
    },
    "auth.impersonation.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to manage this account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 권한이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントを管理する権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权管理此帐户。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para administrar esta cuenta."
          }
        }
      }
    },
    "auth.impersonation.managerNotFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manager account could not be found."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 계정을 찾을 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者アカウントが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到经理帐户。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar la cuenta de administrador."
          }
        }
